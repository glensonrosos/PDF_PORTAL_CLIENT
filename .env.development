# Bind dev server to all interfaces so it can be reached from LAN
HOST=0.0.0.0

# Ensure the WebSocket client (used by HMR/overlay) points to the correct URL
# Adjust the host/IP below if your LAN IP differs
WDS_SOCKET_HOST=10.0.1.249
WDS_SOCKET_PORT=3000
WDS_SOCKET_PATH=/ws

# If you serve the app over HTTPS, uncomment the next two lines
# HTTPS=true
# WDS_SOCKET_PROTOCOL=wss
